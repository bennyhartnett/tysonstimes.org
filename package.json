{
  "name": "tysons-times",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:sync": "node scripts/sync-content.mjs",
    "predev": "npm run content:sync",
    "dev": "vite --host 127.0.0.1",
    "preseo": "npm run content:sync",
    "seo": "node scripts/generate-seo-assets.mjs",
    "prebuild": "node scripts/clean-build.mjs && npm run content:sync && node scripts/generate-seo-assets.mjs",
    "build": "vite build && node scripts/generate-worker-entry.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-publication.mjs",
    "check": "npm run test:unit && npm run build && npm run test:e2e && npm run validate"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
